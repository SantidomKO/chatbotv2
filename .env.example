# Copy this file to .env and edit it for this project/container.
# Inside a shared Docker network, use the MySQL and Rasa service names as hosts.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=chatbot_v2
DB_USER=chatbot_app
DB_PASSWORD=change-this-password

RASA_URL=http://rasa:5005
OLLAMA_URL=http://ollama:11434/api/chat
OLLAMA_MODEL=gemma3:1b
