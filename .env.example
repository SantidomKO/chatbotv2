# Copy this file to .env and replace both password placeholders with different,
# randomly generated values. Do not commit .env or reuse your Linux password.
APP_PORT=8080
APP_BIND_ADDRESS=127.0.0.1
LOCAL_GID=1000
DB_HOST=mysql
DB_PORT=3306
DB_NAME=chatbot_v2
DB_USER=chatbot_app
DB_PASSWORD=replace-with-a-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-random-root-password

RASA_URL=http://rasa:5005
OLLAMA_URL=http://ollama:11434/api/chat
OLLAMA_MODEL=gemma3:1b

# Optional on non-loopback development hosts; loopback testing logs these automatically.
DEBUG_2FA_CODE=false
